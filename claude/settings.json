{
  "env": {
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false"
  },
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)",
      "Bash(git push origin --force *:refs/tags/staging)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "vibe-wise@anthropic-plugin-directory": true
  },
  "syntaxHighlightingDisabled": true,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "light"
}
