#!/bin/sh
# SSH_ASKPASS for the ssh-agent: launchd's dev.moroz.ssh-agent on macOS,
# systemd's ssh-agent.service on Linux (ssh-agent-oshirase.conf).
#
# When a FIDO (-sk) key needs a touch, ssh-agent runs this with
# SSH_ASKPASS_PROMPT=none and the message ("Confirm user presence for key
# ED25519-SK SHA256:...") as $1, and kills it with SIGTERM once the key is
# touched. Show that as a notification through oshirase
# (install-oshirase.sh), and take it down again on SIGTERM: Linux keeps a
# critical notification on screen until it is dismissed. (macOS cannot
# withdraw yet and answers 501; its banner goes away by itself.)
#
# Anything else (passphrase or confirm prompts) is declined: this agent's
# keys need neither.
[ "$SSH_ASKPASS_PROMPT" = none ] || exit 1

oshirase="$HOME/.local/bin/oshirase"
url=http://127.0.0.1:4649
tag=ssh-touch

"$oshirase" send -url "$url" -source ssh -urgency critical -tag "$tag" \
  "Touch your security key" "$1" || exit 1

sleeper=
trap '[ -n "$sleeper" ] && kill "$sleeper" 2>/dev/null
  "$oshirase" withdraw -url "$url" -tag "$tag" >/dev/null 2>&1
  exit 0' TERM INT HUP
# Wait to be killed; a sleep in the background so the trap runs at once.
while :; do
  sleep 60 &
  sleeper=$!
  wait "$sleeper"
done
